local function GetItemsToTrade()
    local tradeable = {}
    local inventory = PlayerData:GetExpect("Inventory")
    if not inventory or not inventory.Items then return {} end

    for _, item in pairs(inventory.Items) do
        local data = ItemUtility:GetItemData(item.Id)
        local isFav = item.Favorite or false
        
        local matchName = (not selectedTradeItemName or data.Name == selectedTradeItemName)
        local matchRarity = (not selectedTradeRarity or data.Rarity == selectedTradeRarity)
        local safeFav = (not tradeHoldFavorite or not isFav)

        if matchName and matchRarity and safeFav then
            table.insert(tradeable, {UUID = item.UUID, Name = data.Name})
        end
    end
    return tradeable
end

local function RunAutoTradeLoop()
    if autoTradeThread then task.cancel(autoTradeThread) end
    
    autoTradeThread = task.spawn(function()
        local tradeCount = 0
        local targetId = selectedTradeTargetId
        
        if not targetId then
            WindUI:Notify({Title = "Error", Content = "Pilih target pemain!", Duration = 3})
            autoTradeState = false
            return
        end
        
        local RF_InitiateTrade = GetServerRemote("RF/InitiateTrade")
        
        while autoTradeState do
            if tradeAmount > 0 and tradeCount >= tradeAmount then break end
            
            local items = GetItemsToTrade()
            if #items == 0 then
                task.wait(2)
                continue
            end
            
            local item = items[1]
            pcall(function()
                RF_InitiateTrade:InvokeServer(targetId, item.UUID)
            end)
            
            tradeCount = tradeCount + 1
            task.wait(tradeDelay)
        end
        autoTradeState = false
    end)
end

