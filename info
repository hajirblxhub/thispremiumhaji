            local itemData = ItemUtility:GetItemData(item.Id)
            if itemData and itemData.Data and (itemData.Data.Name:match("Axe") or itemData.Data.Name:match("Pickaxe")) then
                _G.axeUuid = item.UUID
                return item.UUID
            end
        end
    end
