local function printTable(tbl, indent)
    indent = indent or 0
    local spacing = string.rep("  ", indent)

    for key, value in pairs(tbl) do
        if type(value) == "table" then
            print(spacing .. tostring(key) .. " = {")
            printTable(value, indent + 1)
            print(spacing .. "}")
        else
